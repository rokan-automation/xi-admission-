<%- include('partials/header', { title: 'Admin Login | Eleventh Admission' }) %>

<main class="admin-login-wrapper">
  
  <!-- কাস্টম এরর নোটিফিকেশন পপআপ (কোনো ডিফল্ট অ্যালার্ট নয়) -->
  <% if (locals.error) { %>
    <div id="customErrorToast" class="admin-toast">
      <span>⚠️ <%= error %></span>
    </div>
  <% } %>

  <div class="login-card">
    <div class="login-header">
      <div class="lock-icon-circle">
        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#1d4ed8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <h2>Admin Portal</h2>
      <p>Enter your administrator credentials to access dashboard</p>
    </div>

    <form action="/admin/login" method="POST" autocomplete="off">
      
      <!-- Username Field -->
      <div class="form-group">
        <label for="adminUsername">Username</label>
        <input 
          type="text" 
          id="adminUsername" 
          name="username" 
          placeholder="e.g. admin" 
          required 
          autocomplete="off"
        >
      </div>

      <!-- Password Field with Custom Eye Toggle -->
      <div class="form-group">
        <label for="adminPassword">Password</label>
        <div class="password-wrapper">
          <input 
            type="password" 
            id="adminPassword" 
            name="password" 
            placeholder="••••••••" 
            required 
            autocomplete="current-password"
          >
          <button type="button" id="toggleAdminPassBtn" class="eye-toggle-btn" aria-label="Toggle Password Visibility">
            <svg id="eyeClosedIcon" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
              <line x1="1" y1="1" x2="23" y2="23"></line>
            </svg>
            <svg id="eyeOpenIcon" class="hidden-icon" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
        </div>
      </div>

      <button type="submit" class="btn-signin">Sign In to Dashboard</button>
    </form>
  </div>

</main>

<link rel="stylesheet" href="/public/css/admin-login.css">

<script>
  // Password Visibility Toggle
  const passInput = document.getElementById('adminPassword');
  const toggleBtn = document.getElementById('toggleAdminPassBtn');
  const eyeClosed = document.getElementById('eyeClosedIcon');
  const eyeOpen = document.getElementById('eyeOpenIcon');

  toggleBtn.addEventListener('click', () => {
    const isPass = passInput.type === 'password';
    passInput.type = isPass ? 'text' : 'password';
    eyeClosed.classList.toggle('hidden-icon', isPass);
    eyeOpen.classList.toggle('hidden-icon', !isPass);
  });

  // Auto-dismiss Custom Toast
  const toast = document.getElementById('customErrorToast');
  if (toast) {
    setTimeout(() => {
      toast.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
      toast.style.opacity = '0';
      toast.style.transform = 'translateY(-10px)';
      setTimeout(() => toast.remove(), 300);
    }, 3500);
  }
</script>

<%- include('partials/footer') %>
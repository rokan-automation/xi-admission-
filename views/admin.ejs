          <div class="edit-field"><label>4th Subject *</label><select name="fourth_subject" id="editSciFourth"><option value="Biology (178, 179)">Biology (178, 179)</option><option value="Higher Mathematics (265, 266)">Higher Mathematics (265, 266)</option></select></div>
        </div>`;
    } else if (group === 'Humanities') {
      let html = `<div class="edit-grid-2">`;
      subjectCatalog.Humanities.electives.forEach(el => {
        html += `<div class="edit-field"><label>${el.label}</label><select name="elective_subjects">${el.options.map(opt => `<option value="${opt}">${opt}</option>`).join('')}</select></div>`;
      });
      html += `<div class="edit-field"><label>4th Subject *</label><select name="fourth_subject">${subjectCatalog.Humanities.fourthSubjects.map(opt => `<option value="${opt}">${opt}</option>`).join('')}</select></div></div>`;
      dynamicContainer.innerHTML = html;

<%- include('partials/header', { title: 'Admin Portal | Admission Register', extraStyles: ['/public/css/admin-page.css?v=4'] }) %>

<!-- Fast Vector PDF Generator -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" defer></script>

<main class="admin-wrapper">
  
  <!-- Custom Toast Notification (Auto-Dismiss in 3 Seconds) -->
  <div id="adminSuccessToast" class="admin-success-toast hidden">
    <svg class="toast-svg" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
    </svg>
    <span id="toastText">Student Admission Approved & Assigned Successfully!</span>
  </div>

  <% if (typeof updated !== 'undefined' && updated) { %>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        showCustomToast('✓ Student Admission Approved & Assigned Successfully!');
      });
    </script>
  <% } %>

  <div class="admin-topbar no-print">
    <div>
      <h2>College Admission & Student Register Desk</h2>
      <p>Search by <strong>Tracking ID</strong> or <strong>SSC Roll</strong> to process or edit admission.</p>
    </div>
    <a href="/admin/logout" class="btn-logout">Logout</a>
  </div>

  <!-- ================= SECTION 1: SEARCH & ADMISSION APPROVAL FORM ================= -->
  <div class="search-desk-card no-print">
    
    <!-- Search Bar -->
    <form method="GET" action="/admin/dashboard" class="desk-search-form">
      <div class="search-box-wrap">
        <label for="search_query">
          🔍 Search Student by Tracking ID or SSC Roll:
        </label>
        <div class="input-with-btn">
          <input 
            type="text" 
            id="search_query"
            name="search_query" 
            value="<%= (typeof search_query !== 'undefined' && search_query) ? search_query : '' %>" 
            placeholder="Enter Student Tracking ID (e.g. XI-2026-631725) or SSC Roll" 
            required
            autocomplete="off"
          >
          <button type="submit" class="btn-find">Find &amp; Open Approval Form</button>
          <button type="button" class="btn-analysis-toggle" onclick="toggleAnalysisPanel()">
            <span class="btn-analysis-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 20V10M12 20V4M20 20V14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span> Admission Analysis
          </button>
          <% if (typeof search_query !== 'undefined' && search_query) { %>
            <a href="/admin/dashboard" class="btn-clear">Show Approved Register</a>
          <% } %>
        </div>
      </div>
    </form>

    <% if (typeof notFound !== 'undefined' && notFound) { %>
      <div class="desk-alert-box" style="margin-top:14px; background:#fef2f2; color:#dc2626; border:1px solid #fecaca; padding:10px 14px; border-radius:6px; font-size:13.5px;">
        <span>⚠️ No student application found matching: "<strong><%= search_query %></strong>". Please re-check the ID or Roll.</span>
      </div>
    <% } %>

    <!-- Student Form Processing Panel -->
    <% if (typeof searchedStudent !== 'undefined' && searchedStudent) { %>
      <div id="studentApprovalCard" style="margin-top:20px; padding-top:20px; border-top:2px dashed #cbd5e1;">
        
        <div style="background:#eff6ff; border:1px solid #bfdbfe; padding:14px 18px; border-radius:8px; margin-bottom:18px; display:flex; justify-content:space-between; align-items:center;">
          <div>
            <h4 style="margin:0; color:#1e3a8a; font-size:16px;">Applicant: <strong><%= searchedStudent.full_name_en %></strong> (<%= searchedStudent.full_name_bn || '' %>)</h4>
            <span style="font-size:13px; color:#475569;">App ID: <strong><%= searchedStudent.application_id %></strong> | SSC Roll: <strong><%= searchedStudent.ssc_roll %></strong> | Board: <strong><%= searchedStudent.ssc_board %></strong> | GPA: <strong><%= searchedStudent.gpa %></strong></span>
          </div>
          <span style="background:#fef3c7; color:#92400e; padding:4px 12px; border-radius:12px; font-size:12.5px; font-weight:700; border:1px solid #fde68a;">
            Status: <%= searchedStudent.status %>
          </span>
        </div>

        <form id="approvalForm" method="POST" action="/admin/update-full-application/<%= searchedStudent.id %>">
          
          <!-- ALL EXISTING DATA PRESERVED IN HIDDEN FIELDS -->
          <input type="hidden" name="full_name_en" value="<%= searchedStudent.full_name_en || '' %>">
          <input type="hidden" name="full_name_bn" value="<%= searchedStudent.full_name_bn || '' %>">
          <input type="hidden" name="date_of_birth" value="<%= searchedStudent.date_of_birth ? (searchedStudent.date_of_birth.includes('T') ? searchedStudent.date_of_birth.split('T')[0] : searchedStudent.date_of_birth) : '' %>">
          <input type="hidden" name="father_name_en" value="<%= searchedStudent.father_name_en || '' %>">
          <input type="hidden" name="father_name_bn" value="<%= searchedStudent.father_name_bn || '' %>">
          <input type="hidden" name="father_income" value="<%= searchedStudent.father_income || '0' %>">
          <input type="hidden" name="mother_name_en" value="<%= searchedStudent.mother_name_en || '' %>">
          <input type="hidden" name="mother_name_bn" value="<%= searchedStudent.mother_name_bn || '' %>">
          <input type="hidden" name="mother_income" value="<%= searchedStudent.mother_income || '0' %>">
          <input type="hidden" name="gender" value="<%= searchedStudent.gender || '' %>">
          <input type="hidden" name="religion" value="<%= searchedStudent.religion || '' %>">
          <input type="hidden" name="blood_group" value="<%= searchedStudent.blood_group || '' %>">
          <input type="hidden" name="mobile" value="<%= searchedStudent.mobile || '' %>">
          <input type="hidden" name="email" value="<%= searchedStudent.email || '' %>">
          
          <input type="hidden" name="present_village" value="<%= searchedStudent.present_village || '' %>">
          <input type="hidden" name="present_post_office" value="<%= searchedStudent.present_post_office || '' %>">
          <input type="hidden" name="present_thana" value="<%= searchedStudent.present_thana || '' %>">
          <input type="hidden" name="present_district" value="<%= searchedStudent.present_district || '' %>">
          <input type="hidden" name="permanent_village" value="<%= searchedStudent.permanent_village || '' %>">
          <input type="hidden" name="permanent_post_office" value="<%= searchedStudent.permanent_post_office || '' %>">
          <input type="hidden" name="permanent_thana" value="<%= searchedStudent.permanent_thana || '' %>">
          <input type="hidden" name="permanent_district" value="<%= searchedStudent.permanent_district || '' %>">
          
          <input type="hidden" name="ssc_roll" value="<%= searchedStudent.ssc_roll || '' %>">
          <input type="hidden" name="ssc_reg" value="<%= searchedStudent.ssc_reg || '' %>">
          <input type="hidden" name="ssc_board" value="<%= searchedStudent.ssc_board || '' %>">
          <input type="hidden" name="passing_year" value="<%= searchedStudent.passing_year || '' %>">
          <input type="hidden" name="gpa" value="<%= searchedStudent.gpa || '' %>">
          <input type="hidden" name="ssc_group" value="<%= searchedStudent.ssc_group || '' %>">
          <input type="hidden" name="academic_session" value="<%= searchedStudent.academic_session || '' %>">
          <input type="hidden" name="activity_category" value="<%= searchedStudent.activity_category || 'None' %>">
          <input type="hidden" name="photo_url" value="<%= searchedStudent.photo_url || '' %>">
          <input type="hidden" name="status" value="Approved">

          <!-- Hidden Subjects Input -->
          <input type="hidden" name="compulsory_subjects" id="approveCompulsoryInput">

          <div style="background:#f8fafc; border:1.5px solid #cbd5e1; padding:20px; border-radius:10px; margin-bottom:16px;">
            <h5 style="margin:0 0 14px 0; font-size:14px; color:#0f172a; text-transform:uppercase; font-weight:800;">Assign Class Roll, Money Receipt & Group Subjects</h5>
            
            <!-- 3 Column Layout (No Blood Group) -->
            <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:14px; margin-bottom:16px;">
              <div>
                <label style="font-size:12.5px; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Class Roll Number *</label>
                <input type="text" name="class_roll" value="<%= searchedStudent.class_roll || '' %>" placeholder="e.g. 01" required style="width:100%; padding:9.5px 12px; border:1.5px solid #cbd5e1; border-radius:6px; font-size:13.5px; outline:none; box-sizing:border-box;">
              </div>
              <div>
                <label style="font-size:12.5px; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Money Receipt Number *</label>
                <input type="text" name="receipt_no" value="<%= searchedStudent.receipt_no || '' %>" placeholder="e.g. 12345" required style="width:100%; padding:9.5px 12px; border:1.5px solid #cbd5e1; border-radius:6px; font-size:13.5px; outline:none; box-sizing:border-box;">
              </div>
              <div>
                <label style="font-size:12.5px; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Admission Group *</label>
                <select name="group_name" id="approve_group_name" onchange="renderApprovalSubjects(this.value)" required style="width:100%; padding:9.5px 12px; border:1.5px solid #cbd5e1; border-radius:6px; font-size:13.5px; outline:none; box-sizing:border-box; background:#ffffff;">
                  <option value="Science" <%= searchedStudent.group_name === 'Science' ? 'selected' : '' %>>Science</option>
                  <option value="Humanities" <%= searchedStudent.group_name === 'Humanities' ? 'selected' : '' %>>Humanities</option>
                  <option value="Business Studies" <%= searchedStudent.group_name === 'Business Studies' ? 'selected' : '' %>>Business Studies</option>
                </select>
              </div>
            </div>

            <!-- Compulsory Subjects -->
            <div class="compulsory-card" style="background:#ffffff; border:1px solid #cbd5e1; padding:12px; border-radius:8px; margin-bottom:14px;">
              <span style="font-size:12px; font-weight:700; color:#475569; display:block; margin-bottom:6px;">Compulsory Subjects (Automatic):</span>
              <div id="approvalCompulsoryChips" style="display:flex; flex-wrap:wrap; gap:6px;"></div>
            </div>

            <!-- Dynamic Elective & 4th Subjects UI -->
            <div id="approvalDynamicSubjects" style="background:#ffffff; border:1px solid #cbd5e1; padding:14px; border-radius:8px;"></div>
          </div>

          <div style="display:flex; justify-content:flex-end; gap:12px;">
            <a href="/admin/dashboard" class="btn-cancel" style="text-decoration:none;">Cancel</a>
            <button type="submit" id="approveSubmitBtn" class="btn-action-primary" style="background:#10b981;">
              ✓ Save Admission Data & Move to Approved Register
            </button>
          </div>
        </form>

      </div>
    <% } %>

  </div>

  <!-- ================= ADMISSION ANALYSIS ================= -->
  <% const A = (typeof analytics !== 'undefined' && analytics) ? analytics : { totalByGroup: {}, approvedByGroup: {}, electiveCounts: {}, fourthSubjectCounts: {}, pendingByGroup: {} }; %>
  <% const groupOrder = ['Science', 'Humanities', 'Business Studies']; %>
  <% const allGroupKeys = Array.from(new Set([...groupOrder, ...Object.keys(A.totalByGroup || {})])); %>

  <% const svgChart = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 20V10M12 20V4M20 20V14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>'; %>
  <% const svgFlask = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 3h6M10 3v5.2c0 .4-.1.8-.4 1.1L5.6 15c-1.4 1.7-.2 4.3 2 4.3h8.8c2.2 0 3.4-2.6 2-4.3l-4-5.7c-.3-.3-.4-.7-.4-1.1V3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M7.5 14.5h9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>'; %>
  <% const svgBook = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 5.5C4 4.7 4.7 4 5.5 4H11v16H5.5c-.8 0-1.5-.7-1.5-1.5v-13Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M20 5.5c0-.8-.7-1.5-1.5-1.5H13v16h5.5c.8 0 1.5-.7 1.5-1.5v-13Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>'; %>
  <% const svgBriefcase = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="8" width="18" height="11" rx="2" stroke="currentColor" stroke-width="2"/><path d="M8 8V6.5C8 5.1 9.1 4 10.5 4h3C14.9 4 16 5.1 16 6.5V8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M3 13h18" stroke="currentColor" stroke-width="2"/></svg>'; %>
  <% const svgCap = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 4 2 9l10 5 10-5-10-5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M6 11.5V16c0 1.7 2.7 3 6 3s6-1.3 6-3v-4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>'; %>
  <% const groupIcons = { 'Science': svgFlask, 'Humanities': svgBook, 'Business Studies': svgBriefcase }; %>
  <% const groupAccent = { 'Science': 'accent-blue', 'Humanities': 'accent-amber', 'Business Studies': 'accent-purple' }; %>

  <!-- Defines the official elective "clusters" so subjects are shown grouped & in serial order, not just sorted by count -->
  <% const electiveGroupDefs = {
    'Humanities': [
      ['Economics (109, 110)', 'Civics & Good Governance (269, 270)'],
      ['Islamic History & Culture (267, 268)', 'Sociology (117, 118)', 'Social Work (271, 272)'],
      ['Geography (125, 126)', 'Logic (121, 122)']
    ],
    'Science': [
      ['Physics (174, 175)'],
      ['Chemistry (176, 177)'],
      ['Higher Mathematics (265, 266)', 'Biology (178, 179)']
    ],
    'Business Studies': [
      ['Accounting (253, 254)'],
      ['Business Organization & Management (277, 278)'],
      ['Production Management & Marketing (286, 287)']
    ]
  }; %>

  <div class="analysis-section no-print" id="admissionAnalysisPanel" style="display:none;">
    <div class="analysis-header">
      <div class="analysis-header-icon-badge"><%- svgChart %></div>
      <div>
        <h4>Admission Analysis</h4>
        <p class="analysis-subtitle">Overview of total applications, approvals, and subject selections by group.</p>
      </div>
    </div>

    <div class="analysis-summary-grid">
      <% allGroupKeys.forEach(function(g) { %>
        <% if ((A.totalByGroup && A.totalByGroup[g]) || (A.approvedByGroup && A.approvedByGroup[g])) { %>
          <% const total = (A.totalByGroup && A.totalByGroup[g]) || 0; %>
          <% const approved = (A.approvedByGroup && A.approvedByGroup[g]) || 0; %>
          <% const pct = total > 0 ? Math.round((approved / total) * 100) : 0; %>
          <div class="stat-card <%= groupAccent[g] || 'accent-blue' %>">
            <div class="stat-card-head">
              <div class="stat-icon-badge"><%- groupIcons[g] || svgCap %></div>
              <div class="stat-group-name"><%= g %></div>
            </div>
            <div class="stat-numbers-row">
              <div class="stat-block">
                <span class="stat-value"><%= total %></span>
                <span class="stat-label">Total</span>
              </div>
              <div class="stat-divider"></div>
              <div class="stat-block">
                <span class="stat-value stat-value-green"><%= approved %></span>
                <span class="stat-label">Approved</span>
              </div>
            </div>
            <div class="stat-progress-track">
              <div class="stat-progress-fill" style="width: <%= pct %>%;"></div>
            </div>
            <div class="stat-progress-caption"><%= pct %>% approved</div>

            <% const pendingList = (A.pendingByGroup && A.pendingByGroup[g]) || []; %>
            <% if (pendingList.length) { %>
              <div class="pending-block">
                <div class="pending-block-title">Pending (<%= pendingList.length %>)</div>
                <% pendingList.forEach(function(p) { %>
                  <div class="pending-row">
                    <div class="pending-field">
                      <span class="pending-appid"><%= p.application_id %></span>
                      <button type="button" class="copy-btn" onclick="copyPendingValue(this, '<%= p.application_id %>')" title="Copy Tracking ID">⧉</button>
                    </div>
                    <div class="pending-field">
                      <span class="pending-roll-label">S.S.C Roll:</span>
                      <span class="pending-roll"><%= p.ssc_roll %></span>
                      <button type="button" class="copy-btn" onclick="copyPendingValue(this, '<%= p.ssc_roll %>')" title="Copy S.S.C Roll">⧉</button>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } %>
          </div>
        <% } %>
      <% }); %>
    </div>

    <div class="analysis-subject-grid">
      <% allGroupKeys.forEach(function(g) { %>
        <% const electives = (A.electiveCounts && A.electiveCounts[g]) || {}; %>
        <% const fourths = (A.fourthSubjectCounts && A.fourthSubjectCounts[g]) || {}; %>
        <% if (Object.keys(electives).length || Object.keys(fourths).length) { %>
          <div class="subject-card <%= groupAccent[g] || 'accent-blue' %>">
            <div class="subject-card-head">
              <div class="stat-icon-badge small"><%- groupIcons[g] || svgCap %></div>
              <div class="stat-group-name"><%= g %></div>
            </div>

            <% if (Object.keys(electives).length) { %>
              <% const maxE = Math.max(...Object.values(electives)); %>
              <div class="subject-block-title">Elective Subjects</div>
              <% const defs = electiveGroupDefs[g]; %>
              <% if (defs) { %>
                <% const usedNames = defs.flat(); %>
                <% defs.forEach(function(cluster) { %>
                  <% const clusterSubs = cluster.filter(function(name) { return electives.hasOwnProperty(name); }); %>
                  <% if (clusterSubs.length) { %>
                    <div class="subject-cluster">
                      <% clusterSubs.forEach(function(sub) { %>
                        <div class="subject-row">
                          <div class="subject-row-top">
                            <span class="subject-name"><%= sub %></span>
                            <span class="subject-count"><%= electives[sub] %></span>
                          </div>
                          <div class="subject-bar-track"><div class="subject-bar-fill" style="width: <%= Math.round((electives[sub]/maxE)*100) %>%;"></div></div>
                        </div>
                      <% }); %>
                    </div>
                  <% } %>
                <% }); %>
                <% const leftover = Object.keys(electives).filter(function(k) { return usedNames.indexOf(k) === -1; }).sort(function(a, b) { return electives[b] - electives[a]; }); %>
                <% leftover.forEach(function(sub) { %>
                  <div class="subject-row">
                    <div class="subject-row-top">
                      <span class="subject-name"><%= sub %></span>
                      <span class="subject-count"><%= electives[sub] %></span>
                    </div>
                    <div class="subject-bar-track"><div class="subject-bar-fill" style="width: <%= Math.round((electives[sub]/maxE)*100) %>%;"></div></div>
                  </div>
                <% }); %>
              <% } else { %>
                <% Object.keys(electives).sort((a, b) => electives[b] - electives[a]).forEach(function(sub) { %>
                  <div class="subject-row">
                    <div class="subject-row-top">
                      <span class="subject-name"><%= sub %></span>
                      <span class="subject-count"><%= electives[sub] %></span>
                    </div>
                    <div class="subject-bar-track"><div class="subject-bar-fill" style="width: <%= Math.round((electives[sub]/maxE)*100) %>%;"></div></div>
                  </div>
                <% }); %>
              <% } %>
            <% } %>

            <% if (Object.keys(fourths).length) { %>
              <% const maxF = Math.max(...Object.values(fourths)); %>
              <div class="subject-block-title" style="margin-top:10px;">4th Subject</div>
              <% Object.keys(fourths).sort((a, b) => fourths[b] - fourths[a]).forEach(function(sub) { %>
                <div class="subject-row">
                  <div class="subject-row-top">
                    <span class="subject-name"><%= sub %></span>
                    <span class="subject-count subject-count-alt"><%= fourths[sub] %></span>
                  </div>
                  <div class="subject-bar-track"><div class="subject-bar-fill subject-bar-fill-alt" style="width: <%= Math.round((fourths[sub]/maxF)*100) %>%;"></div></div>
                </div>
              <% }); %>
            <% } %>
          </div>
        <% } %>
      <% }); %>
    </div>
  </div>

  <!-- ================= SECTION 2: APPROVED STUDENTS REGISTER TABLE ================= -->
  <% const approvedList = (typeof approvedApplications !== 'undefined' && Array.isArray(approvedApplications)) ? approvedApplications : []; %>
  <% const curGroup = typeof group_name !== 'undefined' ? group_name : 'all'; %>
  <% const isSearchMode = typeof search_query !== 'undefined' && search_query; %>

  <% if (!isSearchMode) { %>
  <div class="overview-section no-print" id="approvedRegisterSection">
    <div class="overview-header">
      <div>
        <h4>🎓 Approved Students Register (Admitted)</h4>
        <p style="font-size: 13px; color: #64748b; margin-top: 2px;">Official record of enrolled Class XI students.</p>
      </div>
      
      <div class="overview-header-controls">
        <form method="GET" action="/admin/dashboard" class="mini-filter-form">
          <select name="group" id="groupFilterSelect" onchange="this.form.submit()">
            <option value="all" <%= curGroup==='all'?'selected':'' %>>All Groups</option>
            <option value="Science" <%= curGroup==='Science'?'selected':'' %>>Science</option>
            <option value="Humanities" <%= curGroup==='Humanities'?'selected':'' %>>Humanities</option>
            <option value="Business Studies" <%= curGroup==='Business Studies'?'selected':'' %>>Business Studies</option>
          </select>
        </form>

        <button type="button" class="btn-download-photos" onclick="downloadGroupPhotos()">
          <span class="btn-download-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2M7 10l5 5 5-5M12 15V3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          Download Photos (ZIP)
        </button>
      </div>
    </div>

    <div class="table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Roll</th>
            <th>Receipt No</th>
            <th>App ID</th>
            <th>Student Name</th>
            <th>Group</th>
            <th>GPA</th>
            <th style="text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% approvedList.forEach(app => { %>
          <% const encApp = encodeURIComponent(JSON.stringify(app)); %>
          <tr>
            <td><span class="roll-pill"><%= app.class_roll || 'Pending' %></span></td>
            <td><strong><%= app.receipt_no || '-' %></strong></td>
            <td class="bold-id"><%= app.application_id %></td>
            <td><%= app.full_name_en %></td>
            <td><span class="group-tag"><%= app.group_name %></span></td>
            <td><%= app.gpa %></td>
            <td class="action-cell">
              <button type="button" class="btn-tbl btn-view" onclick="handleViewClick('<%= encApp %>')">📄 View</button>
              <button type="button" class="btn-tbl btn-edit" onclick="handleEditClick('<%= encApp %>')">Edit</button>
              <button type="button" class="btn-tbl btn-pdf" onclick="handlePdfClick('<%= encApp %>')">PDF</button>
              <button type="button" class="btn-tbl btn-del" onclick="promptDelete('<%= app.id %>', '<%= app.full_name_en %>')">Delete</button>
            </td>
          </tr>
          <% }) %>
          <% if (approvedList.length === 0) { %>
            <tr>
              <td colspan="7" class="no-records">No approved students found.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

</main>


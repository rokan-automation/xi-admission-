  function toggleAnalysisPanel() {
    const panel = document.getElementById('admissionAnalysisPanel');
    const registerSection = document.getElementById('approvedRegisterSection');
    const isHidden = panel.style.display === 'none' || !panel.style.display;
    panel.style.display = isHidden ? 'block' : 'none';
    if (registerSection) {
      registerSection.style.display = isHidden ? 'none' : 'block';
    }

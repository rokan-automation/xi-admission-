<!-- FIXED PDF ENGINE CONTAINER -->
<div id="pdfEngineContainer" style="position: fixed; top: 0; left: 0; z-index: -9999; opacity: 0; pointer-events: none; width: 210mm; overflow: hidden;"></div>

<script>
  // CUSTOM TOAST NOTIFICATION HANDLER
  let toastTimer = null;
  function showCustomToast(message, isError = false) {
    const toast = document.getElementById('adminSuccessToast');
    const toastText = document.getElementById('toastText');
    if (!toast || !toastText) return;

    toastText.innerText = message;
    toast.style.backgroundColor = isError ? '#EF4444' : '#10B981';
    toast.classList.remove('hidden');

    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toast.classList.add('hidden');
    }, 3000);
  }

  // STRICT CLIENT-SIDE VALIDATION
  function validateFormStrict(formElement) {
    if (!formElement) return true;
    const inputs = formElement.querySelectorAll('input:not([type="hidden"]):not([type="checkbox"]), select');
    let isValid = true;
    let firstInvalidInput = null;

    inputs.forEach(input => {
      if (input.name === 'email' || input.disabled) return; 

      const val = input.value ? input.value.trim() : '';
      if (!val || val === '' || val.startsWith('-- Select')) {
        isValid = false;
        input.style.border = '2px solid #ef4444';
        input.style.backgroundColor = '#fef2f2';
        if (!firstInvalidInput) firstInvalidInput = input;
      } else {
        input.style.border = '1.5px solid #cbd5e1';
        input.style.backgroundColor = '#ffffff';
      }
    });

    if (!isValid && firstInvalidInput) {
      firstInvalidInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
      firstInvalidInput.focus();
      showCustomToast('⚠️ Please fill in all required fields. Only Email is optional!', true);
    }

    return isValid;
  }

  // EXACT SUBJECT CATALOG RULES
  const subjectCatalog = {
    Compulsory: ['Bangla (101, 102)', 'English (107, 108)', 'Information & Communication Technology [ICT] (275)'],
    Science: {
      fixedElectives: ['Physics (174, 175)', 'Chemistry (176, 177)']
    },
    Humanities: {
      electives: [
        { label: 'Elective Subject 1 *', options: ['Economics (109, 110)', 'Civics & Good Governance (269, 270)'] },
        { label: 'Elective Subject 2 *', options: ['Islamic History & Culture (267, 268)', 'Sociology (117, 118)', 'Social Work (271, 272)'] },
        { label: 'Elective Subject 3 *', options: ['Geography (125, 126)', 'Logic (121, 122)'] }
      ],
      fourthSubjects: ['Agricultural Studies (239, 240)', 'Islamic Studies (249, 250)', 'Home Science (273, 274)', 'Psychology (123, 124)']
    },
    BusinessStudies: {
      fixedElectives: ['Accounting (253, 254)', 'Business Organization & Management (277, 278)', 'Production Management & Marketing (286, 287)'],
      fourthSubjects: ['Agricultural Studies (239, 240)', 'Economics (109, 110)', 'Home Science (273, 274)', 'Statistics (129, 130)']
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    const groupSelect = document.getElementById('approve_group_name');
    if (groupSelect) {
      renderApprovalSubjects(groupSelect.value);
    }

    const approvalForm = document.getElementById('approvalForm');
    if (approvalForm) {
      approvalForm.addEventListener('submit', function(e) {
        if (!validateFormStrict(this)) {
          e.preventDefault();
          e.stopPropagation();
          return false;
        }
        const btn = document.getElementById('approveSubmitBtn');
        if (btn) {
          btn.disabled = true;
          btn.textContent = 'Saving Admission & Updating Register...';
        }
      });
    }

    const fullEditForm = document.getElementById('fullEditForm');
    if (fullEditForm) {
      fullEditForm.addEventListener('submit', function(e) {
        if (!validateFormStrict(this)) {
          e.preventDefault();
          e.stopPropagation();
          return false;
        }
        const checkedBoxes = Array.from(document.querySelectorAll('#fullEditModal .edit-act-cb:checked')).map(cb => cb.value);
        document.getElementById('editActivityCategoryHidden').value = checkedBoxes.length > 0 ? checkedBoxes.join(', ') : 'None';
        const btn = document.getElementById('saveEditSubmitBtn');
        if (btn) {
          btn.disabled = true;
          btn.textContent = 'Saving Changes...';
        }
      });
    }
  });

  function renderApprovalSubjects(group) {
    const compContainer = document.getElementById('approvalCompulsoryChips');
    const dynamicContainer = document.getElementById('approvalDynamicSubjects');
    const compInput = document.getElementById('approveCompulsoryInput');

    if (!compContainer || !dynamicContainer || !compInput) return;

    compContainer.innerHTML = subjectCatalog.Compulsory.map(sub => `<span class="sub-badge">✓ ${sub}</span>`).join('');
    compInput.value = subjectCatalog.Compulsory.join(', ');
    dynamicContainer.innerHTML = '';

    if (group === 'Science') {
      dynamicContainer.innerHTML = `
        <div style="margin-bottom:12px;">
          <label style="font-weight:700; color:#334155; font-size:12.5px; display:block; margin-bottom:6px;">Elective Subjects (3 Required):</label>
          <div style="display:flex; flex-wrap:wrap; gap:12px; align-items:center; background:#f1f5f9; padding:10px 14px; border-radius:6px; border:1px solid #cbd5e1; margin-bottom:12px;">
            <label style="font-size:13px; font-weight:700; color:#0f172a; display:flex; align-items:center; gap:6px;">
              <input type="checkbox" checked disabled style="width:16px; height:16px;"> Physics (174, 175)
              <input type="hidden" name="elective_subjects" value="Physics (174, 175)">
            </label>
            <label style="font-size:13px; font-weight:700; color:#0f172a; display:flex; align-items:center; gap:6px;">
              <input type="checkbox" checked disabled style="width:16px; height:16px;"> Chemistry (176, 177)
              <input type="hidden" name="elective_subjects" value="Chemistry (176, 177)">
            </label>
          </div>
        </div>
        <div class="edit-grid-2">
          <div class="edit-field">
            <label>Elective Subject 3 (Major) *</label>
            <select name="elective_subjects" id="appSciElective" onchange="syncAppScience(this.value)" required>
              <option value="Higher Mathematics (265, 266)">Higher Mathematics (265, 266)</option>
              <option value="Biology (178, 179)">Biology (178, 179)</option>
            </select>
          </div>
          <div class="edit-field">
            <label>4th Subject *</label>
            <select name="fourth_subject" id="appSciFourth" required>
              <option value="Biology (178, 179)">Biology (178, 179)</option>
              <option value="Higher Mathematics (265, 266)">Higher Mathematics (265, 266)</option>
            </select>
          </div>
        </div>`;
    } else if (group === 'Humanities') {
      let html = `
        <div style="margin-bottom:12px;">
          <label style="font-weight:700; color:#334155; font-size:12.5px; display:block; margin-bottom:6px;">Elective Subjects (Choose 1 from each group - Total 3 Subjects):</label>
          <div class="edit-grid-3">`;
      subjectCatalog.Humanities.electives.forEach(el => {
        html += `<div class="edit-field"><label>${el.label}</label><select name="elective_subjects" required>${el.options.map(opt => `<option value="${opt}">${opt}</option>`).join('')}</select></div>`;
      });
      html += `</div></div>
        <div class="edit-field" style="margin-top:12px;">
          <label>4th Subject *</label>
          <select name="fourth_subject" required>${subjectCatalog.Humanities.fourthSubjects.map(opt => `<option value="${opt}">${opt}</option>`).join('')}</select>
        </div>`;
      dynamicContainer.innerHTML = html;
    } else {
      dynamicContainer.innerHTML = `
        <div style="margin-bottom:12px;">
          <label style="font-weight:700; color:#334155; font-size:12.5px; display:block; margin-bottom:6px;">Elective Subjects (All 3 Compulsory):</label>
          <div style="display:flex; flex-wrap:wrap; gap:12px; align-items:center; background:#f1f5f9; padding:10px 14px; border-radius:6px; border:1px solid #cbd5e1; margin-bottom:12px;">
            <label style="font-size:13px; font-weight:700; color:#0f172a; display:flex; align-items:center; gap:6px;">
              <input type="checkbox" checked disabled style="width:16px; height:16px;"> Accounting (253, 254)
              <input type="hidden" name="elective_subjects" value="Accounting (253, 254)">
            </label>
            <label style="font-size:13px; font-weight:700; color:#0f172a; display:flex; align-items:center; gap:6px;">
              <input type="checkbox" checked disabled style="width:16px; height:16px;"> Business Organization & Management (277, 278)
              <input type="hidden" name="elective_subjects" value="Business Organization & Management (277, 278)">
            </label>
            <label style="font-size:13px; font-weight:700; color:#0f172a; display:flex; align-items:center; gap:6px;">
              <input type="checkbox" checked disabled style="width:16px; height:16px;"> Production Management & Marketing (286, 287)
              <input type="hidden" name="elective_subjects" value="Production Management & Marketing (286, 287)">
            </label>
          </div>
        </div>
        <div class="edit-field" style="margin-top:12px;">
          <label>4th Subject *</label>
          <select name="fourth_subject" required>${subjectCatalog.BusinessStudies.fourthSubjects.map(opt => `<option value="${opt}">${opt}</option>`).join('')}</select>
        </div>
      `;
    }
  }

  function syncAppScience(val) {
    const fourthSelect = document.getElementById('appSciFourth');
    if (fourthSelect) {
      fourthSelect.value = val.includes('Higher Mathematics') ? 'Biology (178, 179)' : 'Higher Mathematics (265, 266)';
    }
  }

  // Safe Decoders
  function handleEditClick(encodedApp) {
    try {
      const app = JSON.parse(decodeURIComponent(encodedApp));
      openFullEditModal(app);
    } catch(e) { console.error(e); }
  }

  function handleViewClick(encodedApp) {
    try {
      const app = JSON.parse(decodeURIComponent(encodedApp));
      openOfficialFormPreview(app);
    } catch(e) { console.error(e); }
  }

  function handlePdfClick(encodedApp) {
    try {
      const app = JSON.parse(decodeURIComponent(encodedApp));
      triggerDirectPDF(app);
    } catch(e) { console.error(e); }
  }

  // OFFICIAL FORM PREVIEW MODAL
  function openOfficialFormPreview(app) {
    const container = document.getElementById('officialFormModalContent');
    const photoHtml = app.photo_url 
      ? `<img src="${app.photo_url}" loading="lazy" width="130" height="155" style="width:130px; height:155px; object-fit:cover; border:1.5px solid #cbd5e1; border-radius:4px;" crossorigin="anonymous">`
      : `<div style="width:130px; height:155px; border:1.5px solid #cbd5e1; display:flex; align-items:center; justify-content:center; font-size:12px; color:#94a3b8; background:#f8fafc; border-radius:4px;">Photo Attached</div>`;

    container.innerHTML = `
      <div style="border: 2px solid #1e3a8a; padding: 22px 26px; border-radius: 4px; background:#ffffff;">
        <div style="text-align:center; border-bottom:2px solid #1e3a8a; padding-bottom:10px; margin-bottom:14px;">
          <h1 style="margin:0; color:#1e3a8a; font-size:25px; text-transform:uppercase; font-weight:800; font-family:'Times New Roman', serif;">Birganj Govt. College</h1>
          <p style="margin:2px 0 0 0; font-size:14px; font-style:italic; font-weight:600; color:#475569;">Birganj, Dinajpur</p>
          <div style="margin-top:5px; display:inline-block; background:#eff6ff; border:1px solid #bfdbfe; padding:3px 14px; border-radius:4px; font-size:12.5px; font-weight:800; color:#1e3a8a;">Higher Secondary (Class XI) Official Admission Form</div>
          <p style="margin:3px 0 0 0; font-size:11.5px; color:#64748b;">Academic Session: ${app.academic_session || '2026-2027'} | Official College Record</p>
        </div>

        <div style="background:#ecfdf5; border:1px solid #a7f3d0; padding:8px 16px; border-radius:6px; display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; font-size:13px;">
